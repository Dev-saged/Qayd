rules_version = '2';

// عزل كل محل ببياناته عبر claims (shopId, role, super_admin) التي يضعها Worker qayd-admin فقط.
// صلاحيات الموظف من members/{uid}.perms، والمميزات المدفوعة من config/features و shops.paid.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function isSuper() { return signedIn() && request.auth.token.get('super_admin', false) == true; }
    function inShop(shopId) { return signedIn() && request.auth.token.get('shopId', '') == shopId; }
    function isOwner(shopId) { return inShop(shopId) && request.auth.token.get('role', '') == 'owner'; }
    function shop(shopId) { return get(/databases/$(db)/documents/shops/$(shopId)).data; }
    function shopActive(shopId) {
      let s = shop(shopId);
      return s.active == true && (s.get('licenseUntil', null) == null || s.licenseUntil > request.time);
    }
    function me(shopId) { return get(/databases/$(db)/documents/shops/$(shopId)/members/$(request.auth.uid)).data; }
    function member(shopId) { return isSuper() || (inShop(shopId) && shopActive(shopId) && (isOwner(shopId) || me(shopId).active == true)); }
    function can(shopId, p) {
      return isSuper() || (inShop(shopId) && shopActive(shopId)
        && (isOwner(shopId) || (me(shopId).active == true && me(shopId).perms.get(p, false) == true)));
    }
    function featureOn(shopId, f) {
      let s = shop(shopId);
      let cfg = get(/databases/$(db)/documents/config/features).data;
      return s.get('modules', {}).get(f, false) == true
        && (cfg.get(f, 'free') == 'free' || s.get('paid', {}).get(f, false) == true);
    }
    function quota(shopId) { return shop(shopId).get('smsQuota', -1); }
    function withinQuota(shopId, n) { return quota(shopId) < 0 || n <= quota(shopId); }
    function smsMonth() { return 'sms-' + string(request.time.year()) + '-' + string(request.time.month()); }
    function smsCounted(shopId) {
      let path = /databases/$(db)/documents/shops/$(shopId)/usage/$(smsMonth());
      let before = exists(path) ? get(path).data.get('count', 0) : 0;
      return isSuper() || quota(shopId) < 0
        || (existsAfter(path) && getAfter(path).data.get('count', 0) > before && withinQuota(shopId, getAfter(path).data.get('count', 0)));
    }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function byMe() { return request.resource.data.get('by', '') == request.auth.uid || isSuper(); }

    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isSuper();
    }

    match /presence/{shopId} {
      allow read, delete: if isSuper();
      allow write: if inShop(shopId)
        && request.resource.data.keys().hasOnly(['lastSeen', 'version', 'by', 'customers', 'members', 'smsUsed']);
    }

    match /payments/{id} {
      allow read, write: if isSuper();
    }

    // رموز روابط الكشف: يقرؤها الـ Worker فقط
    match /links/{token} {
      allow create: if signedIn() && request.resource.data.shopId == request.auth.token.get('shopId', '')
        && request.resource.data.keys().hasOnly(['shopId', 'customerId', 'createdAt']);
    }

    match /suffixes/{suffix} {
      allow read: if isSuper();
      allow write: if false;
    }

    match /shops/{shopId} {
      allow read: if isSuper() || inShop(shopId);

      // مالك المنصة: تفريغ المحل واستعادة نسخه
      match /{sub=**} {
        allow read, write: if isSuper();
      }
      allow create, delete: if isSuper();
      allow update: if isSuper() || (isOwner(shopId) && onlyChanges(['name', 'updatedAt']));

      match /members/{uid} {
        allow read: if isSuper() || inShop(shopId);
        allow create, delete: if isSuper();
        allow update: if isSuper()
          || (isOwner(shopId) && uid != request.auth.uid
              && onlyChanges(['displayName', 'perms', 'active', 'updatedAt']))
          || (inShop(shopId) && uid == request.auth.uid && onlyChanges(['avatar', 'updatedAt']));
      }

      match /customers/{id} {
        allow read: if member(shopId);
        allow create: if byMe() && (can(shopId, 'manageCustomers') || can(shopId, 'addDebt') || can(shopId, 'manageElectricity'));
        allow update: if (can(shopId, 'manageCustomers') || can(shopId, 'addDebt') || can(shopId, 'manageElectricity'))
          && (byMe() || onlyChanges(['limit', 'waPrefix', 'link', 'updatedAt']));
      }

      match /tx/{id} {
        allow read: if member(shopId);
        allow create: if byMe() && (
          (request.resource.data.kind == 'sale' && (can(shopId, 'quickSale') || can(shopId, 'managePs')))
          || (request.resource.data.kind == 'debt' && (can(shopId, 'addDebt') || can(shopId, 'recordReadings') || can(shopId, 'managePs')))
          || (request.resource.data.kind == 'payment' && can(shopId, 'addPayment'))
          || (request.resource.data.kind == 'expense' && can(shopId, 'expenses'))
          || (request.resource.data.kind == 'discount' && can(shopId, 'discount')));
        allow update: if (can(shopId, 'deleteTx') && onlyChanges(['deleted', 'deletedBy', 'deletedByName', 'updatedAt']))
          || (member(shopId) && resource.data.by == request.auth.uid && onlyChanges(['payer', 'payerPhone', 'updatedAt']))
          || (can(shopId, 'confirmTransfers') && onlyChanges(['verify', 'verifiedBy', 'verifiedAt', 'updatedAt']));
      }

      match /recurring/{id} {
        allow read: if member(shopId);
        allow write: if can(shopId, 'expenses');
      }

      match /audit/{id} {
        allow read: if isSuper() || isOwner(shopId);
        allow create: if member(shopId) && byMe();
      }

      match /settings/{doc} {
        allow read: if member(shopId);
        allow write: if can(shopId, 'setPrices');
      }

      match /ps/{screen} {
        allow read: if member(shopId);
        allow write: if can(shopId, 'managePs') && featureOn(shopId, 'ps');
      }

      match /readings/{id} {
        allow read: if member(shopId);
        allow create: if byMe() && can(shopId, 'recordReadings') && featureOn(shopId, 'electricity');
        allow update: if can(shopId, 'manageElectricity');
      }

      match /templates/{id} {
        allow read: if member(shopId);
        allow write: if can(shopId, 'manageTemplates');
      }

      match /smsQueue/{id} {
        allow read: if member(shopId);
        allow create: if byMe() && can(shopId, 'sendSms') && featureOn(shopId, 'sms') && smsCounted(shopId);
        allow update: if member(shopId) && onlyChanges(['status', 'error', 'sentAt', 'deliveredAt', 'attempts', 'gateway', 'updatedAt']);
      }

      match /products/{id} {
        allow read: if member(shopId);
        allow write: if can(shopId, 'manageStock') && featureOn(shopId, 'inventory');
      }

      match /moves/{id} {
        allow read: if member(shopId);
        allow create: if byMe() && featureOn(shopId, 'inventory')
          && (can(shopId, 'manageStock') || (request.resource.data.kind == 'sale' && can(shopId, 'quickSale')));
      }

      match /suppliers/{id} {
        allow read: if member(shopId);
        allow write: if can(shopId, 'manageSuppliers') && featureOn(shopId, 'suppliers');
      }

      match /stx/{id} {
        allow read: if member(shopId);
        allow create: if byMe() && featureOn(shopId, 'suppliers')
          && (can(shopId, 'manageSuppliers') || (can(shopId, 'manageStock') && request.resource.data.kind == 'purchase'));
        allow update: if can(shopId, 'manageSuppliers') && onlyChanges(['deleted', 'updatedAt']);
      }

      match /menu/{id} {
        allow read: if member(shopId);
        allow write: if can(shopId, 'manageMenu') && featureOn(shopId, 'menu');
      }

      match /orders/{id} {
        allow read: if member(shopId);
        allow create: if byMe() && can(shopId, 'quickSale') && featureOn(shopId, 'menu');
        allow update: if (can(shopId, 'quickSale') && onlyChanges(['status', 'updatedAt']) && request.resource.data.status != 'cancelled')
          || (can(shopId, 'deleteTx') && onlyChanges(['status', 'updatedAt']));
      }

      match /holds/{id} {
        allow read: if member(shopId);
        allow create: if byMe() && can(shopId, 'quickSale') && featureOn(shopId, 'layaway');
        allow update: if featureOn(shopId, 'layaway') && (
          (can(shopId, 'quickSale') && request.resource.data.status != 'cancelled')
          || can(shopId, 'deleteTx'));
      }

      match /closes/{id} {
        allow read: if member(shopId);
        allow create: if byMe() && member(shopId);
      }

      match /usage/{doc} {
        allow read: if member(shopId);
        allow create, update: if can(shopId, 'sendSms') && featureOn(shopId, 'sms')
          && request.resource.data.keys().hasOnly(['count']) && request.resource.data.count is int
          && request.resource.data.count >= (resource == null ? 0 : resource.data.count)
          && withinQuota(shopId, request.resource.data.count);
      }

      match /gateway/{doc} {
        allow read, write: if member(shopId);
      }
    }
  }
}
